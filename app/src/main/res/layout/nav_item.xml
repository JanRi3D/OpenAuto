<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_item_h"
    android:background="@drawable/bg_nav"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/nav_pad"
    android:paddingRight="@dimen/nav_pad">

    <me.ri3d.openauto.ui.IconView
        android:id="@+id/icon"
        android:layout_width="@dimen/nav_icon"
        android:layout_height="@dimen/nav_icon"
        app:icon="sliders"
        app:iconColor="@color/muted" />

    <me.ri3d.openauto.ui.BarlowText
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:includeFontPadding="false"
        android:textColor="@color/muted"
        android:textSize="@dimen/nav_text"
        app:font="medium" />
</LinearLayout>
