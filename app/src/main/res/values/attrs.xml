<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="IconView">
        <attr name="icon" format="enum">
            <enum name="wifi" value="0" />
            <enum name="usb" value="1" />
            <enum name="self" value="2" />
            <enum name="sliders" value="3" />
            <enum name="arrow_right" value="4" />
            <enum name="arrow_left" value="5" />
            <enum name="monitor" value="6" />
            <enum name="speaker" value="7" />
            <enum name="target" value="8" />
            <enum name="bluetooth" value="9" />
            <enum name="plus" value="10" />
            <enum name="minus" value="11" />
            <enum name="activity" value="12" />
            <enum name="close" value="13" />
        </attr>
        <attr name="iconColor" format="color" />
        <attr name="iconStroke" format="float" />
    </declare-styleable>
    <declare-styleable name="BarlowText">
        <attr name="font" format="enum">
            <enum name="regular" value="0" />
            <enum name="medium" value="1" />
            <enum name="semibold" value="2" />
            <enum name="condensed" value="3" />
        </attr>
        <attr name="wordmark" format="boolean" />
    </declare-styleable>
</resources>
